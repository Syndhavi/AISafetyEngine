{
  "manifest_version": 3,
  "name": "AI Safety Guardian",
  "version": "1.0",
  "action": {
  "default_popup": "popup.html"
},
  "permissions": ["activeTab", "scripting", "tabs","storage"],
  "host_permissions": ["http://127.0.0.1:5001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"]
    }
  ]
}